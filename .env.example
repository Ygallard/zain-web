# ====================================
# ZAINO WEB - Configuración de Variables de Entorno
# ====================================

# ===== Arduino IoT Cloud Credentials =====
# Obtén estas credenciales en: https://cloud.arduino.cc/
CLIENT_ID=your_arduino_client_id_here
CLIENT_SECRET=your_arduino_client_secret_here

# ===== Weathercloud API Credentials =====
# Regístrate en: https://weathercloud.net/
WEATHERCLOUD_EMAIL=your_email@example.com
WEATHERCLOUD_PASSWORD=your_weathercloud_password

# ID de tu estación meteorológica de Weathercloud
WEATHERCLOUD_DEVICEID=YOUR_STATION_ID

# ===== Flask Security Configuration =====
# Clave secreta para sesiones y seguridad de Flask
# IMPORTANTE: En producción, genera una clave aleatoria única
# Puedes generar una con: python -c "import os; print(os.urandom(24).hex())"
# Si no se especifica, la aplicación generará una aleatoria automáticamente
SECRET_KEY=your_secret_key_here_generate_random_in_production

# ===== Application Settings =====
# Puerto en el que se ejecutará la aplicación Flask
PORT=5000

# ===== Django backend =====
# URL real del servicio Django, sin barra final. Obligatoria en producción.
DJANGO_BACKEND_URL=https://c75ec961-2801-4906-9ed7-dd97ea6c39ac.urrahosting.cl

# ===== Login de aplicación =====
# Credenciales para inicio de sesión web
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# Activar solo durante un redeploy para crear/actualizar el admin inicial.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_RUT=11.111.111-1
BOOTSTRAP_ADMIN_NOMBRE=Administrador

# ====================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Completa todas las variables con tus credenciales reales
# 3. NUNCA compartas o subas el archivo .env a git
# ====================================
